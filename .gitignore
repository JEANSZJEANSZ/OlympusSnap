# =============================================================================
# Olympus Snap — gitignore
#
# COMMIT these (not listed here):
#   - All source under src/, public/, docs/, worker/src/, worker/migrations/
#   - Config templates: .env.example, worker/.dev.vars.example
#   - Worker deploy config: worker/wrangler.toml, worker/package.json,
#     worker/package-lock.json
#   - Root package.json, package-lock.json, vite.config.js, index.html, etc.
#
# NEVER COMMIT secrets or local-only files (listed below).
# =============================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output (reinstall / rebuild locally)
node_modules
dist
dist-ssr
build
dist-ssr

# Graphify / local tooling caches (regenerated)
graphify-out
.impeccable
.svelte-kit
.output

# Env secrets — commit .env.example only (see negation below)
.env
.env.*
!.env.example
!.env.test

# Vite local overrides
*.local

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Vite temp
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright artifacts
test-results
docker-compose.yml
Dockerfile
nginx.conf
.gitea
.cursor


AGENTS.md