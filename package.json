{
  "name": "olympus-snap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/**/*.test.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:d1:local": "wrangler d1 migrations apply olympus-snap --local",
    "cf:d1:remote": "wrangler d1 migrations apply olympus-snap --remote",
    "cf:lifecycle": "wrangler r2 bucket lifecycle set olympus-snap --file worker/r2-lifecycle.json"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.4",
    "vite": "^8.1.1",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "animejs": "^4.5.0",
    "konva": "^10.3.0",
    "matter-js": "^0.20.0",
    "qrcode": "^1.5.4",
    "three": "^0.185.1"
  }
}
