# =============================================================================
# Cloudflare Worker — gitignore
#
# COMMIT:
#   - src/, migrations/, wrangler.toml, package.json, package-lock.json
#   - .dev.vars.example (template — no secrets)
#
# NEVER COMMIT:
#   - .dev.vars (local BOOTH_KEY for wrangler dev)
#   - .wrangler/ (local D1/R2/miniflare state)
#   - node_modules/
# =============================================================================

.wrangler/
.dev.vars
node_modules/
