# Optional — not required.
# API base defaults live in vite.config.js:
#   npm run dev  → http://localhost:6101
#   npm run build → https://sfapi.smartfactory.forum
#
# Override only if needed:
# VITE_API_BASE=https://sfapi.smartfactory.forum
#
# Photobooth Auth is entered on the Admin unlock gate (not env).
# QR origin falls back to location.origin when VITE_PUBLIC_ORIGIN is unset.
