# Booth build — set when deploying the photobooth tablet
# Worker URL (production) or leave empty for offline IndexedDB + session stub mode
VITE_API_BASE=

# Shared secret for booth-only POST routes (sessions, asset CRUD)
# Set the same value via: wrangler secret put BOOTH_KEY
VITE_BOOTH_KEY=

# Public origin guest phones use for QR links (NOT localhost in production)
# Example: https://events.example.com
VITE_PUBLIC_ORIGIN=

# Local dev with wrangler (same machine):
# VITE_API_BASE=http://127.0.0.1:8787
# VITE_BOOTH_KEY=your-dev-secret
# VITE_PUBLIC_ORIGIN=http://localhost:5173
#
# Or proxy mode (Vite forwards /api → wrangler):
# VITE_API_BASE=
# Then use relative fetches — only works if sessionClient/assetApi use empty base with proxy.
# Recommended: set VITE_API_BASE=http://127.0.0.1:8787 explicitly.
